%% SEQ 9 — SYSTÈME DE NOTIFICATIONS
%% ═══════════════════════════════════════════════════════════════════════════════

participant "Backend" as BE
database "PostgreSQL" as DB
participant "Firebase" as FB
participant "SMTP" as SMTP
actor "Utilisateur" as U
participant "Mobile" as MOB

== Notification Push (Mobile) ==

U->>MOB: Enregistre device token
MOB->>BE: POST /api/notifications/register-device
BE->>DB: INSERT INTO device_token (utilisateur_id, token, platform)
BE-->>MOB: 200 OK

BE->>BE: Événement déclencheur (candidature, tâche, etc.)
BE->>DB: INSERT INTO notification (utilisateur_id, titre, message)
BE->>FB: FCM.send(deviceToken, {title, body})
FB-->>U: Notification push sur téléphone

== Notification Email ==

BE->>SMTP: SMTP.send(to, template, data)
SMTP-->>U: Email (confirmation, entretien, décision)

== Notification In-App ==

U->>MOB: Ouvre le dashboard
MOB->>BE: GET /api/notifications
BE->>DB: SELECT * FROM notification WHERE lue = false
BE-->>MOB: 200 [notifications]
MOB-->>U: Badge + liste notifications

U->>MOB: Marquer comme lue
MOB->>BE: PUT /api/notifications/:id/read
BE->>DB: UPDATE notification SET lue = true
BE-->>MOB: 200 OK


%% ═══════════════════════════════════════════════════════════════════════════════
%% SEQ 10 — ENTRETIEN EXPRESS HUMAIN (Raccourci Backend)
%% ═══════════════════════════════════════════════════════════════════════════════

actor "RH" as RH
participant "Backoffice" as BO
participant "Backend" as BE
database "PostgreSQL" as DB
participant "SMTP" as SMTP
actor "Encadrant" as ENC

RH->>BO: Bouton "Entretien Express"
BO->>BE: POST /api/candidacies/:id/schedule-express-human-interview
BE->>DB: INSERT INTO human_interviews (interviewer = 'Encadrant désigné', statut = 'PLANIFIE')
BE->>DB: UPDATE candidature SET statut = 'EN_ENTRETIEN_HUMAIN'
BE->>SMTP: email "Entretien express planifié" (encadrant)
BE->>SMTP: email "Entretien express planifié" (candidat)
BE->>DB: INSERT INTO notification (RH, encadrant, candidat)
BE-->>BO: 200 {humanInterviewId}
BO-->>RH: Entretien planifié
note over RH: L'encadrant reçoit un email\navec les détails de l'entretien
