# Serveur
PORT=3000
JWT_SECRET=change-me-en-vraie-cle-secrete
JWT_EXPIRES_IN=24h
# Portail candidat (frontweb) et panneau admin (backoffice) autorisés.
# frontweb :4200 — backoffice :4400 (aucun conflit de port entre les deux).
CORS_ORIGIN=http://localhost:4200,http://localhost:4400
# URL de base du portail candidat (liens dans les e-mails : vérification,
# mot de passe, entretien IA).
FRONTEND_URL=http://localhost:4200

# Microservice Python d'entretien IA (ai-service).
# PYTHON_SERVICE_TOKEN doit être identique au SERVICE_TOKEN de ai-service/.env.
PYTHON_AI_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_TOKEN=change-me-jeton-service
PYTHON_AI_TIMEOUT_MS=8000

# Vérification documentaire IA (même microservice Python, POST /api/documents/verify).
# AI_DOCUMENT_SERVICE_URL  : URL du service (fallback : PYTHON_AI_SERVICE_URL).
# AI_DOCUMENT_SERVICE_TOKEN: jeton de service (fallback : PYTHON_SERVICE_TOKEN).
# AI_DOCUMENT_TIMEOUT_MS   : délai maximal d'une vérification (ms), 10000 par défaut.
AI_DOCUMENT_SERVICE_URL=http://localhost:8001
AI_DOCUMENT_TIMEOUT_MS=10000
# AI_DOCUMENT_SERVICE_TOKEN=change-me-jeton-service

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=steg_stage
DB_USER=postgres
DB_PASSWORD=change-me

# --- Email (SMTP) -----------------------------------------------------------
# Configuration du transporteur Nodemailer (voir backend/config/email.js).
# Si MAIL_HOST / MAIL_USER / MAIL_PASS sont vides, aucun email n'est envoyé :
# le contenu est journalisé dans la console (mode dev / test).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=votre.email@gmail.com
MAIL_PASS=votre-mot-de-passe-d-application
MAIL_FROM="STEG Internship <votre.email@gmail.com>"

# Niveau de journalisation : DEBUG | INFO | WARN | ERROR
# LOG_LEVEL=DEBUG

# Rappel automatique de l'entretien humain (jour J).
# Tâche périodique démarrée au lancement du backend : rappel envoyé le jour
# même de l'entretien (fuseau Africa/Tunis). Actif par défaut ; passer à
# "false" pour désactiver (ex. en dev pour ne pas envoyer de vrais emails
# pendant les tests d'intégration).
# REMINDER_JOB_ENABLED=true
# Intervalle entre deux passages (minutes), 5 par défaut.
# REMINDER_INTERVAL_MIN=5

# --- Accès à l'application mobile (email D-1) -------------------------------
# Email automatique avec l'accès à l'application mobile (identifiant + mot de
# passe temporaire), envoyé la veille du début du stage (fuseau Africa/Tunis).
# Lien de téléchargement de l'application mobile affiché dans l'email.
# Optionnel : sans valeur, la section « Télécharger l'application » est omise.
# MOBILE_APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=...
# Clé de chiffrement (AES-256-GCM) du mot de passe temporaire persisté entre la
# préparation et l'envoi D-1. Fallback : JWT_SECRET si non définie.
# MOBILE_CREDENTIALS_ENCRYPTION_KEY=change-me-cle-chiffrement-mobile
# Tâche périodique d'envoi (J-1). Active par défaut ; passer à "false" pour
# désactiver (ex. en dev pour ne pas envoyer de vrais emails pendant les tests).
# MOBILE_ACCESS_JOB_ENABLED=true
# Intervalle entre deux passages (minutes), 60 par défaut.
# MOBILE_ACCESS_JOB_INTERVAL_MIN=60
