# Port d'écoute du microservice Python (uvicorn).
PYTHON_SERVICE_PORT=8001

# URL du backend Node.js/Express (appels serveur-à-serveur + origine CORS).
NODE_BACKEND_URL=

# Clés API des fournisseurs externes — NE PAS COMMITTER de vraies clés.
AI_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# Fournisseur Speech-to-Text : "auto" (OpenAI si STT_API_KEY renseignée,
# sinon Mock local), "openai" (exige STT_API_KEY) ou "mock" (test hors ligne).
STT_PROVIDER=auto

# Fournisseur Text-to-Speech :
#   "auto"   -> OpenAI si TTS_API_KEY renseignée, sinon edge-tts (voix neuronales
#               Microsoft, gratuit), sinon voix système (say macOS / espeak-ng Linux) ;
#   "openai" -> exige TTS_API_KEY ;
#   "edge"   -> edge-tts (nécessite `pip install edge-tts`) ;
#   "system" -> voix système hors ligne (say / espeak-ng) ;
#   "mock"   -> WAV silencieux (tests hors ligne).
TTS_PROVIDER=auto

# Voix utilisées par les fournisseurs TTS.
TTS_VOICE=fr-FR-DeniseNeural        # edge-tts (voix neuronale française)
TTS_SYSTEM_VOICE=Thomas             # voix système macOS (say)

# Secret de signature des jetons d'entretien (doit correspondre à celui du backend Node).
INTERVIEW_TOKEN_SECRET=

# Jeton de service : authentification Node <-> Python.
# DOIT être identique à PYTHON_SERVICE_TOKEN dans backend/.env.
SERVICE_TOKEN=change-me-jeton-service

# Vérification de documents d'onboarding (CV, CIN, DEMANDE_STAGE,
# LETTRE_AFFECTATION).
# Taille maximale d'un document (octets). Défaut 10 Mo (aligné sur le backend Node).
DOCUMENT_MAX_BYTES=10485760
# Exiger un moteur OCR pour lire les documents image/scannés : "true" force le
# service à échouer (503) si tesseract n'est pas installé.
DOCUMENT_OCR_REQUIRED=false
